{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": [
    "./**/*.ts",
    "../../packages/experience/**/*.ts",
    "./**/*.tsx",
    "../../packages/ui/src/**/*.tsx",
    "../../packages/ui/src/**/*.ts"
  ]
}
